# =========================
# Simple CBOW Example
# =========================

import numpy as np
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Embedding, Lambda, Dense

# -------------------------
# 1. Sample Sentence
# -------------------------
sentence = "I love deep learning"
words = sentence.lower().split()  # convert to lowercase
vocab = list(set(words))          # unique words

# Create word-index mappings
word_to_index = {w: i+1 for i, w in enumerate(vocab)}
index_to_word = {i+1: w for i, w in enumerate(vocab)}

print("Word to Index:", word_to_index)

# -------------------------
# 2. Create Context-Target Pairs
# -------------------------
context_size = 1
contexts = []
targets = []

for i in range(context_size, len(words)-context_size):
    target = words[i]
    context = [words[i-1], words[i+1]]
    contexts.append([word_to_index[w] for w in context])
    targets.append(word_to_index[target])

X = np.array(contexts)
Y = np.array(targets)

print("Contexts (indices):", X)
print("Targets (indices):", Y)

# -------------------------
# 3. Build CBOW Model
# -------------------------
vocab_size = len(vocab) + 1  # +1 for padding index 0
embedding_dim = 4

model = Sequential([
    Embedding(input_dim=vocab_size, output_dim=embedding_dim),
    Lambda(lambda x: tf.reduce_mean(x, axis=1)),  # average embeddings
    Dense(vocab_size, activation='softmax')       # predict target word
])

model.compile(loss='sparse_categorical_crossentropy', optimizer='adam', metrics=['accuracy'])

# -------------------------
# 4. Train Model
# -------------------------
model.fit(X, Y, epochs=200, verbose=0)

# -------------------------
# 5. Predict
# -------------------------
test_context = ["i", "deep"]
x_test = np.array([[word_to_index[w] for w in test_context]])
pred = model.predict(x_test)
pred_word = index_to_word[np.argmax(pred[0])]

print(f"Context: {test_context} -> Predicted Target: {pred_word}")
