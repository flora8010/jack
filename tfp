#tensorflow

import tensorflow as tf
import numpy as np
from keras import models,layers

a= tf.constant(5)
b= tf.constant(15)
print(a+b)

x = np.random.rand(100).astype('float32')
print(x)

y = x*0.2+0.2


#build model
model = models.Sequential([
    layers.Dense(1, input_shape=(1,))
])


#compile 
model.compile(optimizer='sgd',loss='mse')

#train
model.fit(x,y, epochs=100)



test_val = np.array([[5.0], [10.0], [15.0], [30.0]], dtype='float32')

# Predict
y_pred = model.predict(test_val)

# Print predictions
for i in range(len(test_val)):
    print(f"Predicted value for x = {test_val[i][0]} :: {y_pred[i][0]:.4f}")

# Get learned weight and bias
wt, bias = model.layers[0].get_weights()
print("\nLearned Weight (W):", wt)
print("Learned Bias (b):", bias)

